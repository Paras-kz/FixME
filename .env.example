# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Leave unset for local dev to use the local fixme.db SQLite file.
# Set to a Neon (or any Postgres) connection string in production, e.g.:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Login gate credentials for the whole app.
APP_USERNAME=changeme
APP_PASSWORD=changeme

# Random long string used to encrypt the session cookie. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
STORAGE_SECRET=
